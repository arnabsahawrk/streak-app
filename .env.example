# Copy this file to .env.local for local development, and add the same
# two variables in Vercel → Project → Settings → Environment Variables.

# Neon connection string. In Vercel, adding the Neon marketplace
# integration sets this for you automatically — copy its value here for
# local dev. In the Neon console it's the "pooled connection" string.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Whatever passcode you want to unlock the app with. Leave this unset
# locally if you don't want the login screen while developing.
APP_PASSCODE="choose-something-only-you-know"
